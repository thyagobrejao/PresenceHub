# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Network
NETWORK_INTERFACE=eth0
NETWORK_SUBNET=192.168.1.0/24

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=presencehub
MQTT_TOPIC_PREFIX=home/presence

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/presencehub.db

# Presence
PRESENCE_TIMEOUT=300
PRESENCE_DECAY_INTERVAL=60
PRESENCE_DECAY_RATE=5
PRESENCE_ONLINE_THRESHOLD=50

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# Home Assistant
HA_DISCOVERY_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant
